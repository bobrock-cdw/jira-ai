# Jira credentials
JIRA_USERNAME=your.email@company.com
JIRA_API_TOKEN=your-jira-api-token

# Jira defaults used by the CLI/API
JIRA_SERVER=https://yourcompany.atlassian.net
JIRA_SERVERS=https://yourcompany.atlassian.net,https://sandbox.atlassian.net
JIRA_PROJECT_KEY=MC
JIRA_COMPONENT=Cloud
JIRA_ASSIGNEE=Your Name

# Vertex AI / Gemini defaults
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated origins allowed to call the FastAPI backend from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
